{
  "schema": "ogm.smallscaleint-ui-needs/1",
  "set": "smallscaleint",
  "note": "Inventory, skill, HUD and map elements the first SmallScaleInt game needs, in the asset workflow's priority order: an installed pack first, a variant of an owned asset second.",
  "groups": [
    "Equipment",
    "Consumable",
    "Skill",
    "HUD",
    "Map"
  ],
  "variants": {
    "V-ITEM-CLOSEUP": {
      "op": "nearest-neighbour upscale to the slot size, then palette snap to the SmallScaleInt fantasy ramp",
      "result": "readable close-up inventory art from an installed world sprite, geometry unchanged"
    },
    "V-SKILL-CROP": {
      "op": "crop one representative frame of a same-family animation and composite it into the slot frame",
      "result": "a skill icon drawn from the set's own effects, not from another game's artwork"
    },
    "V-HUD-TINT": {
      "op": "clone the frame and recolour it to the kit's bronze/slate ramp",
      "result": "one HUD family at a consistent colour without changing geometry"
    },
    "V-MAP-PARCHMENT": {
      "op": "palette-reduce a map asset to four colours and scale it by a whole factor",
      "result": "a dedicated parchment map that reads as UI, not as the gameplay scene"
    },
    "V-MAP-FOG": {
      "op": "runtime reveal masks drawn over the parchment map",
      "result": "unknown, hinted and revealed states without baking one session's routes"
    }
  },
