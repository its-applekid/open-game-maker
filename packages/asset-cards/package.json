{
  "name": "@ogm/asset-cards",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "pretypecheck": "pnpm --filter @ogm/contracts build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @ogm/contracts build",
    "test": "vitest run && python3 -I ../../scripts/assets/test_build_collection_cards.py",
    "lint": "eslint src",
    "licenses:emit": "tsc -b && node scripts/emit-licenses.mjs && prettier --write data/licenses.json"
  },
  "dependencies": {
    "@ogm/contracts": "workspace:*",
    "sharp": "0.35.5"
  }
}
