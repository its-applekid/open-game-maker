{
  "name": "@ogm/voice-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "sync-contracts": "node scripts/sync-aiur-contracts.mjs",
    "e2e": "pnpm run build && playwright test",
    "test:browser": "pnpm run e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/ws": "8.18.2",
    "ajv": "8.20.0",
    "prettier": "3.9.10",
    "ws": "8.22.1"
  }
}
