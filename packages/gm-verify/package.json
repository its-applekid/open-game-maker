{
  "name": "@ogm/gm-verify",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./report": {
      "types": "./dist/report.d.ts",
      "default": "./dist/report.js"
    },
    "./budgets": {
      "types": "./dist/budgets.d.ts",
      "default": "./dist/budgets.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "build": "tsc -b",
    "emit": "node scripts/emit-schema.mjs",
    "pretypecheck": "pnpm --filter @ogm/contracts build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @ogm/contracts build",
    "test": "vitest run",
    "pretest:browser": "pnpm --filter @ogm/contracts build",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@ogm/contracts": "workspace:*",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  }
}
