{
  "name": "@ogm/gm-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "gm": "dist/index.js"
  },
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "pretypecheck": "pnpm --filter @ogm/contracts --filter @ogm/config --filter @ogm/asset-cards --filter @ogm/asset-measure --filter @ogm/gm-verify build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @ogm/contracts --filter @ogm/config --filter @ogm/asset-cards --filter @ogm/asset-measure --filter @ogm/gm-verify build",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@ogm/asset-cards": "workspace:*",
    "@ogm/asset-measure": "workspace:*",
    "@ogm/config": "workspace:*",
    "@ogm/contracts": "workspace:*",
    "adm-zip": "0.6.1",
    "sharp": "0.35.5",
    "tar": "7.5.22",
    "@ogm/gm-verify": "workspace:*"
  }
}
