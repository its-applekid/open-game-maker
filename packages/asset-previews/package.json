{
  "name": "@ogm/asset-previews",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "pretypecheck": "pnpm --filter @ogm/config build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @ogm/config build",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@ogm/config": "workspace:*",
    "playwright": "1.64.1",
    "sharp": "0.35.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1"
  }
}
