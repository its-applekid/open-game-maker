{
  "name": "@gm/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./test": {
      "types": "./dist/test/index.d.ts",
      "import": "./dist/test/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./assets": {
      "types": "./dist/assets/index.d.ts",
      "import": "./dist/assets/index.js"
    },
    "./fx": {
      "types": "./dist/fx/index.d.ts",
      "import": "./dist/fx/index.js"
    },
    "./nav": {
      "types": "./dist/nav/index.d.ts",
      "import": "./dist/nav/index.js"
    },
    "./proc": {
      "types": "./dist/proc/index.d.ts",
      "import": "./dist/proc/index.js"
    },
    "./phaser": {
      "types": "./dist/phaser/index.d.ts",
      "import": "./dist/phaser/index.js"
    }
  },
  "scripts": {
    "prebuild": "node scripts/list-pixelfx.mjs --check",
    "build": "tsc -b && node scripts/build.mjs",
    "pretypecheck": "node scripts/list-pixelfx.mjs --check && tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node scripts/list-pixelfx.mjs --check && tsc -b",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@ogm/contracts": "workspace:*",
    "@ogm/iframe-bridge": "workspace:*",
    "fastnoise-lite": "1.1.1",
    "meshoptimizer": "1.3.0",
    "phaser": "4.2.1",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "27.0.0",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "jsdom": "27.4.0",
    "recast-navigation": "0.43.1",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "recast-navigation": "0.43.1"
  },
  "peerDependenciesMeta": {
    "recast-navigation": {
      "optional": true
    }
  }
}
