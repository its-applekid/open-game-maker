{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "create_repo"
        },
        "gameId": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "private"
          ]
        },
        "templateRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "gameId",
        "owner",
        "visibility",
        "templateRef"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "fold_design"
        },
        "gameId": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "content"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "gameId",
        "base",
        "files"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "fork"
        },
        "sourceGameId": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha": {
          "type": "string",
          "minLength": 1
        },
        "newGameId": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "private"
          ]
        }
      },
      "required": [
        "kind",
        "sourceGameId",
        "sourceSha",
        "newGameId",
        "owner",
        "visibility"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "release"
        },
        "gameId": {
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "type": "string",
          "minLength": 1
        },
        "semver": {
          "type": "string",
          "minLength": 1
        },
        "changelog": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "gameId",
        "sha",
        "semver",
        "changelog"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "merge"
        },
        "gameId": {
          "type": "string",
          "minLength": 1
        },
        "prNumber": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "gameId",
        "prNumber"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "set_visibility"
        },
        "gameId": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "private"
          ]
        }
      },
      "required": [
        "kind",
        "gameId",
        "visibility"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "file_issue"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "kind",
        "title",
        "body",
        "labels"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "create_branch"
        },
        "gameId": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "gameId",
        "branch",
        "sha"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "https://open-game-maker-2000.local/schemas/commit.v1.json"
}
