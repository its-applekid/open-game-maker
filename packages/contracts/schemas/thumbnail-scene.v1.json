              "selection": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "E",
                      "N",
                      "NE",
                      "NW",
                      "S",
                      "SE",
                      "SW",
                      "W"
                    ]
                  },
                  "frame": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
