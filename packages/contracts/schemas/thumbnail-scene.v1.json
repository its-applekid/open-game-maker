                      },
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "scale": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16
                  }
