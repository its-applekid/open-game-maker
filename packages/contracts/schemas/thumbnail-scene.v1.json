              "position": {
                "type": "object",
                "properties": {
                  "grid": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "items": false,
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "offset_px": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "integer",
