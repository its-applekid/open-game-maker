        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "world": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "kind",
        "id",
        "world"
      ],
      "additionalProperties": false
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "const": 1024
        },
        "height": {
          "type": "number",
