                  "effect"
                ]
              },
              "role": {
                "type": "string",
                "enum": [
                  "hero",
                  "enemy",
                  "companion"
                ]
              },
              "card_id": {
                "type": "string",
                "pattern": "^t[1-3]:[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9/._-]*@[A-Za-z0-9._-]+$"
