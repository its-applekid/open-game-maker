{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "gameId": {
      "type": "string",
      "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
    },
    "branchId": {
      "default": "main",
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "new_game",
        "feature",
        "repair",
        "scope"
      ]
    },
    "complexity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "plan": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "maxLength": 4000
        },
        "scope": {
          "type": "object",
          "properties": {
            "included": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "excluded": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "included",
            "excluded"
          ],
          "additionalProperties": false
        },
        "targetControls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tickets": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "acceptanceCriteria": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "key",
              "skills",
              "dependsOn",
              "acceptanceCriteria"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "summary",
        "scope",
        "tickets"
      ],
      "additionalProperties": false
    },
    "start": {
      "default": "now",
      "type": "string",
      "enum": [
        "now",
        "at_reset"
      ]
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "gameId",
    "branchId",
    "kind",
    "complexity",
    "plan",
    "start"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/jobs.create-job.request.v1.json"
}
