{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "family": {
      "type": "string",
      "enum": [
        "chunky-low-poly",
        "detailed-low-poly",
        "simple-low-poly",
        "pixel-art",
        "flat-cartoon",
        "isometric-2d",
        "sketch",
        "photoreal",
        "any"
      ]
    },
    "pov": {
      "type": "string",
      "enum": [
        "iso",
        "topdown",
        "side",
        "follow",
        "fps",
        "orbit",
        "fixed"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:t[12]:[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9/._-]*@[A-Za-z0-9._-]+|t3:[A-Za-z0-9][A-Za-z0-9_-]*\\/[a-z0-9][a-z0-9/._-]*)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "rights": {
            "type": "object",
            "properties": {
              "uses": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "in-game",
                    "placeholder",
                    "derive-layout",
                    "style-reference",
                    "vision-input",
                    "edit-audio",
                    "derive-audio"
                  ]
                }
              },
              "audience": {
                "type": "string",
                "enum": [
                  "private",
                  "public"
                ]
              },
              "redistribution": {
                "type": "string",
                "enum": [
                  "none",
                  "in-build",
                  "free"
                ]
              },
              "attribution": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "uses",
              "audience",
              "redistribution",
              "attribution"
            ],
            "additionalProperties": {}
          },
          "meta": {
            "type": "object",
            "properties": {
              "sprite": {
                "$ref": "#/$defs/__schema0"
              },
              "rig": {
                "$ref": "#/$defs/__schema1"
              },
              "kit": {
                "$ref": "#/$defs/__schema2"
              },
              "geometry": {
                "$ref": "#/$defs/__schema3"
              }
            },
            "additionalProperties": false
          },
          "derived_from": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?:t[12]:[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9/._-]*@[A-Za-z0-9._-]+|t3:[A-Za-z0-9][A-Za-z0-9_-]*\\/[a-z0-9][a-z0-9/._-]*)$"
            }
          },
          "added": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "id",
          "sha256",
          "path",
          "license",
          "rights",
          "added"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "version",
    "family",
    "pov",
    "assets"
  ],
  "additionalProperties": {},
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    },
    "__schema2": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema2"
          }
        }
      ]
    },
    "__schema3": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema3"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema3"
          }
        }
      ]
    }
  },
  "$id": "https://open-game-maker-2000.local/schemas/assets-lock.v1.json"
}
