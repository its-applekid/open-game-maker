{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "pov": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "rights": {
            "type": "object",
            "properties": {
              "uses": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "audience": {
                "type": "string",
                "enum": [
                  "private",
                  "public"
                ]
              },
              "redistribution": {
                "type": "string",
                "enum": [
                  "none",
                  "in-build",
                  "free"
                ]
              },
              "attribution": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "uses",
              "audience",
              "redistribution",
              "attribution"
            ],
            "additionalProperties": {}
          },
          "derived_from": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "added": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "sha256",
          "path",
          "license",
          "rights",
          "added"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "version",
    "family",
    "pov",
    "assets"
  ],
  "additionalProperties": {},
  "$id": "https://open-game-maker-2000.local/schemas/assets-lock.v1.json"
}
