{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "enum": [
        "game",
        "member"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
    },
    "from": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "to": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "builds": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "usageMicroUsd": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "byActivity": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "asset_pipeline",
          "level_building",
          "gameplay_code",
          "animation_vfx",
          "audio",
          "ui_hud",
          "playtesting",
          "deploy_release",
          "writing"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "durationMs": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "count",
          "durationMs"
        ],
        "additionalProperties": false
      },
      "required": [
        "asset_pipeline",
        "level_building",
        "gameplay_code",
        "animation_vfx",
        "audio",
        "ui_hud",
        "playtesting",
        "deploy_release",
        "writing"
      ]
    }
  },
  "required": [
    "scope",
    "id",
    "from",
    "to",
    "builds",
    "usageMicroUsd",
    "byActivity"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/analytics.rollup.v1.json"
}
