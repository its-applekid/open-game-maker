                    "path": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^\\/(?:globals|entities)(?:\\/.*)?$"
                        },
                        {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              }
                            ]
                          }
                        }
                      ]
                    },
                    "value": {}
                  },
                  "required": [
                    "op",
                    "path"
                  ],
                  "additionalProperties": {}
                }
              }
