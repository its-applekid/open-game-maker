            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tick": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "data": {
            "type": "string",
            "maxLength": 87384,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        },
        "required": [
          "t",
          "seq",
          "tick",
          "data"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
