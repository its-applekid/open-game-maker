{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "t": {
      "type": "string",
      "const": "net.start"
    },
    "epoch": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "startAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "primarySeat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "seats": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seat": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "maxLength": 40
          },
          "team": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "connected": {
            "type": "boolean"
          },
          "ready": {
            "type": "boolean"
          },
          "forfeited": {
            "type": "boolean"
          }
        },
        "required": [
          "seat",
          "userId",
          "name",
          "team",
          "connected",
          "ready",
          "forfeited"
        ],
        "additionalProperties": false
      }
    },
    "privateSeed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "required": [
    "t",
    "epoch",
    "mode",
    "startAt",
    "seed",
    "primarySeat",
    "seats"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/net.start.v1.json"
}
