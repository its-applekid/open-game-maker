{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "image",
        "text"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "mime": {
      "type": "string",
      "enum": [
        "image/webp",
        "text/plain",
        "text/markdown",
        "application/json"
      ]
    },
    "bytes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 10485760
    }
  },
  "required": [
    "id",
    "kind",
    "name",
    "mime",
    "bytes"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/chat.attachment.v1.json"
}
