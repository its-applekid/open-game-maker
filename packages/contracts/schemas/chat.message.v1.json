{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
        },
        {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        }
      ]
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "actor": {
      "type": "string",
      "enum": [
        "creator",
        "agent",
        "system"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "clip",
        "checkpoint",
        "progress"
      ]
    },
    "text": {
      "type": "string"
    },
    "media": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "poster": {
          "type": "string",
          "format": "uri"
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "url",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "decision_id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "media_id": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "recommend": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "answered",
            "moot"
          ]
        }
      },
      "required": [
        "decision_id",
        "question",
        "options",
        "status"
      ],
      "additionalProperties": false
    },
    "aiur": {
      "type": "object",
      "properties": {
        "ticket": {
          "type": "string"
        },
        "event_id": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "topic": {
          "type": "string"
        }
      },
      "required": [
        "ticket"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "job_id",
    "at",
    "actor",
    "kind"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/chat.message.v1.json"
}
