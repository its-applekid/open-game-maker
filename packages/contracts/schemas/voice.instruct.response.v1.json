{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "delivery_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "delivered",
        "queued_at_reset",
        "needs_choice",
        "failed"
      ]
    }
  },
  "required": [
    "delivery_id",
    "status"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/voice.instruct.response.v1.json"
}
