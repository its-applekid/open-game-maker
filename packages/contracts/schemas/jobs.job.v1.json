{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
    },
    "gameId": {
      "type": "string",
      "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
    },
    "branchId": {
      "type": "string"
    },
    "familyId": {
      "type": "string",
      "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
    },
    "creatorId": {
      "type": "string",
      "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "new_game",
        "feature",
        "repair",
        "scope"
      ]
    },
    "complexity": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "admitted",
        "filed",
        "running",
        "paused_budget",
        "done",
        "failed",
        "cancelled"
      ]
    },
    "pausedReason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "over_reservation",
            "budget_exhausted",
            "admin"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "start": {
      "type": "string",
      "enum": [
        "now",
        "at_reset"
      ]
    },
    "startAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "slot": {
      "type": "string",
      "enum": [
        "new_game",
        "edit"
      ]
    },
    "plan": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "maxLength": 4000
        },
        "scope": {
          "type": "object",
          "properties": {
            "included": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "excluded": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "included",
            "excluded"
          ],
          "additionalProperties": false
        },
        "tickets": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "acceptanceCriteria": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "key",
              "skills",
              "dependsOn",
              "acceptanceCriteria"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "summary",
        "scope",
        "tickets"
      ],
      "additionalProperties": false
    },
    "reservation": {
      "type": "object",
      "properties": {
        "amountMicroUsd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sizeClass": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large",
            "huge"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "required": [
        "amountMicroUsd",
        "sizeClass",
        "confidence"
      ],
      "additionalProperties": false
    },
    "hardCapMicroUsd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "usageMicroUsd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "aiurRepo": {
      "type": [
        "string",
        "null"
      ]
    },
    "aiurIssueNumber": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "aiurSpendCapMicroUsd": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "idempotencyKey": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "terminalAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "queued_ogm",
        "waiting_capacity",
        "waiting_provider",
        "building",
        "final_tests",
        "fixing",
        "ready",
        "out_of_budget",
        "paused",
        "done",
        "failed",
        "cancelled"
      ]
    },
    "stageText": {
      "type": "string"
    },
    "phase": {
      "type": "string",
      "enum": [
        "brainstorm",
        "plan",
        "work",
        "review"
      ]
    },
    "progressPercent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  },
  "required": [
    "id",
    "gameId",
    "branchId",
    "familyId",
    "creatorId",
    "kind",
    "complexity",
    "state",
    "pausedReason",
    "start",
    "startAt",
    "slot",
    "plan",
    "reservation",
    "hardCapMicroUsd",
    "usageMicroUsd",
    "aiurRepo",
    "aiurIssueNumber",
    "aiurSpendCapMicroUsd",
    "idempotencyKey",
    "createdAt",
    "updatedAt",
    "terminalAt"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/jobs.job.v1.json"
}
