{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "pin": {
      "type": "object",
      "properties": {
        "gameId": {
          "type": "string",
          "minLength": 1
        },
        "branchId": {
          "type": "string",
          "minLength": 1
        },
        "buildId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "gameId",
        "branchId",
        "buildId"
      ],
      "additionalProperties": false
    },
    "ownerId": {
      "type": "string",
      "minLength": 1
    },
    "editorSessionId": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "enum": [
        "editing",
        "migrating",
        "playing",
        "pausedForHost",
        "ended"
      ]
    },
    "phaseAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "playRev": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lastRev": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxPlayers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "members": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "player"
            ]
          },
          "playerIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "connected": {
            "type": "boolean"
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "userId",
          "name",
          "role",
          "playerIndex",
          "connected",
          "sessions"
        ],
        "additionalProperties": false
      }
    },
    "presence": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "selection": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "focusControlId": {
          "type": "string",
          "minLength": 1
        },
        "camera": {
          "type": "object",
          "properties": {
            "pos": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            "target": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            "zoom": {
              "type": "number"
            }
          },
          "required": [
            "pos",
            "target",
            "zoom"
          ],
          "additionalProperties": false
        },
        "privateMode": {
          "type": "boolean"
        },
        "building": {
          "type": "object",
          "properties": {
            "jobId": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string"
            },
            "pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "jobId",
            "label",
            "pct"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "selection",
        "privateMode"
      ],
      "additionalProperties": false
    },
    "draft": {
      "type": "object",
      "properties": {
        "buildId": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "buildId",
        "url",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "seats": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seat": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "userId": {
            "type": "string",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "maxLength": 40
          },
          "team": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "connected": {
            "type": "boolean"
          },
          "ready": {
            "type": "boolean"
          },
          "forfeited": {
            "type": "boolean"
          },
          "spectator": {
            "type": "boolean"
          }
        },
        "required": [
          "seat",
          "userId",
          "name",
          "team",
          "connected",
          "ready",
          "forfeited",
          "spectator"
        ],
        "additionalProperties": false
      }
    },
    "spectators": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "epoch": {
      "type": "string"
    },
    "startAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pausedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "primarySeat": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "rulesetHash": {
      "type": "string",
      "maxLength": 64
    }
  },
  "required": [
    "protocol",
    "pin",
    "ownerId",
    "phase",
    "phaseAt",
    "playRev",
    "lastRev",
    "maxPlayers",
    "members",
    "presence",
    "seats",
    "spectators",
    "epoch",
    "startAt",
    "pausedAt",
    "primarySeat",
    "seed",
    "rulesetHash"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/net.room-state.v2.json"
}
