{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "build.done"
        },
        "userIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
          }
        },
        "gameId": {
          "type": "string",
          "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
        },
        "jobId": {
          "type": "string",
          "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
        },
        "buildId": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "userIds",
        "gameId",
        "jobId",
        "buildId",
        "ok"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "job.started"
        },
        "userIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
          }
        },
        "gameId": {
          "type": "string",
          "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
        },
        "jobId": {
          "type": "string",
          "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
        }
      },
      "required": [
        "kind",
        "userIds",
        "gameId",
        "jobId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "intake.report"
        },
        "userIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
          }
        },
        "dropId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "imported",
            "awaiting-license",
            "blocked",
            "duplicate"
          ]
        }
      },
      "required": [
        "kind",
        "userIds",
        "dropId",
        "status"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "https://open-game-maker-2000.local/schemas/notifications.trigger.v1.json"
}
