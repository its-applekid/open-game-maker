{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "triaged"
        },
        "result": {
          "type": "object",
          "properties": {
            "reportId": {
              "type": "string",
              "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
            },
            "replay": {
              "type": "object",
              "properties": {
                "class": {
                  "type": "string",
                  "enum": [
                    "reproduces_with_error",
                    "reproduces_no_error",
                    "not_reproducible"
                  ]
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "no_actions",
                    "no_keyframe",
                    "state_mismatch",
                    "timeout"
                  ]
                },
                "durationMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "class",
                "durationMs"
              ],
              "additionalProperties": false
            },
            "signature": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "diagnosticsKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "ticket": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "body": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                },
                "labels": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                }
              },
              "required": [
                "title",
                "body",
                "labels"
              ],
              "additionalProperties": false
            },
            "promise": {
              "type": "object",
              "properties": {
                "specPath": {
                  "type": "string",
                  "pattern": "^promises\\/[0-9a-f]{64}\\.spec\\.ts$"
                },
                "replayPath": {
                  "type": "string",
                  "pattern": "^promises\\/[0-9a-f]{64}\\.replay\\.json$"
                }
              },
              "required": [
                "specPath",
                "replayPath"
              ],
              "additionalProperties": false
            },
            "editorHint": {
              "type": "object",
              "properties": {
                "controlId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "suggestion": {
                  "type": "string",
                  "enum": [
                    "increase",
                    "decrease",
                    "toggle"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                }
              },
              "required": [
                "controlId",
                "suggestion",
                "reason"
              ],
              "additionalProperties": false
            },
            "dedupedInto": {
              "type": "string",
              "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
            }
          },
          "required": [
            "reportId",
            "replay"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "stored"
        },
        "reason": {
          "type": "string",
          "enum": [
            "bundle_fetch_failed",
            "bundle_too_large",
            "invalid_bundle",
            "replay_failed"
          ]
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    }
  ],
  "$id": "https://open-game-maker-2000.local/schemas/reports.triage.complete.v1.json"
}
