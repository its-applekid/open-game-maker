{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ogm.thumbnail-sheet-3d/1.0"
    },
    "background": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "grid": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "rotate_deg_per_second": {
      "type": "number",
      "minimum": 0,
      "maximum": 360
    },
    "ground": {
      "type": "object",
      "properties": {
        "size_m": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "position": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "colour": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        }
      },
      "required": [
        "size_m",
        "position",
        "colour"
      ],
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "properties": {
        "fov_deg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 90
        },
        "position": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "target": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "fov_deg",
        "position",
        "target"
      ],
      "additionalProperties": false
    },
    "models": {
      "minItems": 1,
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "card_id": {
            "type": "string",
            "pattern": "^t[1-3]:[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9/._-]*@[A-Za-z0-9._-]+$"
          },
          "position": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          }
        },
        "required": [
          "id",
          "card_id",
          "position",
          "scale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "background",
    "grid",
    "rotate_deg_per_second",
    "ground",
    "camera",
    "models"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/thumbnail-sheet-3d.v1.json"
}
