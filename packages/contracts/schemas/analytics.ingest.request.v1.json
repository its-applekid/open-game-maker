{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "events": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ts": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "gameId": {
            "type": "string",
            "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
          },
          "jobId": {
            "type": "string",
            "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
          },
          "aiurRunId": {
            "type": "string",
            "maxLength": 80
          },
          "attemptId": {
            "type": "string",
            "maxLength": 80
          },
          "actor": {
            "type": "string",
            "enum": [
              "agent",
              "human"
            ]
          },
          "activity": {
            "type": "string",
            "enum": [
              "asset_pipeline",
              "level_building",
              "gameplay_code",
              "animation_vfx",
              "audio",
              "ui_hud",
              "playtesting",
              "deploy_release",
              "writing"
            ]
          },
          "boundary": {
            "type": "string",
            "enum": [
              "start",
              "end",
              "point"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "gm_cli",
              "skill",
              "editor",
              "sdk",
              "manifest_path"
            ]
          },
          "meta": {
            "default": {},
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "maxLength": 120
              },
              "system": {
                "type": "string",
                "maxLength": 60
              },
              "path": {
                "type": "string",
                "maxLength": 200
              },
              "count": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "durationMs": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "result": {
                "type": "string",
                "enum": [
                  "ok",
                  "fail"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "ts",
          "gameId",
          "actor",
          "activity",
          "boundary",
          "source",
          "meta"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "events"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/analytics.ingest.request.v1.json"
}
