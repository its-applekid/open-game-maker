{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "seed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "startAt": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "primary": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "seats": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seat": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "userId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "team": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "connected": {
            "type": "boolean"
          },
          "ready": {
            "type": "boolean"
          },
          "forfeited": {
            "type": "boolean"
          },
          "spectator": {
            "type": "boolean"
          }
        },
        "required": [
          "seat",
          "userId",
          "name",
          "team",
          "connected",
          "ready",
          "forfeited",
          "spectator"
        ],
        "additionalProperties": false
      }
    },
    "privateSeed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "epoch",
    "seed",
    "startAt",
    "tick",
    "primary",
    "seats"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/net.start.v2.json"
}
