{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "familyId": {
      "type": "string",
      "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
    },
    "resetZone": {
      "type": "string"
    },
    "unitLabel": {
      "type": "string"
    },
    "microUsdPerUnit": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "platformCapMicroUsd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "slots": {
      "type": "object",
      "properties": {
        "new_game": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "edit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "new_game",
        "edit"
      ],
      "additionalProperties": false
    },
    "hardCapMultiplier": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "familyId",
    "resetZone",
    "unitLabel",
    "microUsdPerUnit",
    "platformCapMicroUsd",
    "slots",
    "hardCapMultiplier"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/budget.settings.v1.json"
}
