{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
    },
    "game_id": {
      "type": "string",
      "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
    },
    "creator_id": {
      "type": "string",
      "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
    },
    "ticket": {
      "type": "string",
      "pattern": "^\\d+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "revising",
        "agreed",
        "abandoned"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "choices": {
      "type": "object",
      "properties": {
        "genre": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "vibe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "world": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "players": {
          "type": "string",
          "enum": [
            "single",
            "multi"
          ]
        },
        "pov": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "other": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "genre",
        "vibe",
        "family",
        "world",
        "players",
        "pov"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
        },
        "revision": {
          "default": 1,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "scope": {
          "type": "object",
          "properties": {
            "included": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "excluded": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          },
          "required": [
            "included",
            "excluded"
          ],
          "additionalProperties": false
        },
        "tickets": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "skills": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "dependsOn": {
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "acceptanceCriteria": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              }
            },
            "required": [
              "key",
              "title",
              "skills",
              "dependsOn",
              "acceptanceCriteria"
            ],
            "additionalProperties": false
          }
        },
        "complexity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "open_questions": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "ideas": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "required": [
        "session_id",
        "revision",
        "title",
        "summary",
        "scope",
        "tickets",
        "complexity",
        "open_questions",
        "ideas"
      ],
      "additionalProperties": false
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "id",
    "game_id",
    "creator_id",
    "job_id",
    "status",
    "revision",
    "choices",
    "at"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/scope.session.v1.json"
}
