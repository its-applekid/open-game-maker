{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "saveSlot": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9]*_)?[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "gameId": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9]*_)?[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "slotId": {
          "type": "string",
          "enum": [
            "1",
            "2",
            "3",
            "auto"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ]
        },
        "label": {
          "type": "string"
        },
        "headRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "needs_migration",
            "unsupported_old",
            "incompatible_after_rollback"
          ]
        }
      },
      "required": [
        "userId",
        "gameId",
        "slotId",
        "kind",
        "headRevision",
        "status"
      ],
      "additionalProperties": {}
    },
    "saveRevision": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9]*_)?[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "gameId": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9]*_)?[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "slotId": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "branchId": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9]*_)?[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "buildId": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9]*_)?[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "releaseId": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9]*_)?[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "saveSchemaVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "deviceId": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9]*_)?[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "clientSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string",
          "enum": [
            "pause",
            "checkpoint",
            "interval",
            "hidden",
            "manual",
            "migration",
            "update"
          ]
        },
        "migratedFromRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "payload": {
          "type": "string",
          "contentEncoding": "base64"
        }
      },
      "required": [
        "userId",
        "gameId",
        "slotId",
        "revision",
        "branchId",
        "buildId",
        "saveSchemaVersion",
        "sha256",
        "deviceId",
        "clientSeq",
        "reason",
        "createdAt",
        "payload"
      ],
      "additionalProperties": {}
    },
    "playLease": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9]*_)?[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "gameId": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9]*_)?[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "deviceId": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9]*_)?[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "tabId": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9]*_)?[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "userId",
        "gameId",
        "deviceId",
        "tabId",
        "expiresAt"
      ],
      "additionalProperties": {}
    },
    "achievementDef": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        },
        "progress": {
          "type": "object",
          "properties": {
            "target": {
              "type": "number"
            }
          },
          "required": [
            "target"
          ],
          "additionalProperties": {}
        },
        "retired": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "title",
        "description",
        "icon",
        "hidden"
      ],
      "additionalProperties": {}
    },
    "analyticsEvent": {
      "type": "object",
      "properties": {
        "ts": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "gameId": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9]*_)?[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "branchId": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9]*_)?[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "releaseId": {
          "type": "string",
          "pattern": "^(?:[a-z][a-z0-9]*_)?[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "env": {
          "type": "string",
          "enum": [
            "draft",
            "published"
          ]
        },
        "pseudoUserId": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "marker": {
          "type": "string"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "complete",
            "fail",
            "quit"
          ]
        },
        "props": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "ts",
        "gameId",
        "branchId",
        "env",
        "pseudoUserId",
        "sessionId",
        "name"
      ],
      "additionalProperties": {}
    }
  },
  "required": [
    "saveSlot",
    "saveRevision",
    "playLease",
    "achievementDef",
    "analyticsEvent"
  ],
  "additionalProperties": {},
  "$id": "https://open-game-maker-2000.local/schemas/saves.v1.json"
}
