{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "playerIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source": {
      "type": "string",
      "enum": [
        "keyboard",
        "pointer",
        "touch",
        "gamepad",
        "network"
      ]
    },
    "actions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": {}
          }
        ]
      }
    }
  },
  "required": [
    "playerIndex",
    "tick",
    "source",
    "actions"
  ],
  "additionalProperties": {},
  "$id": "https://open-game-maker-2000.local/schemas/input.v1.json"
}
