{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "built": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "tiers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "desktop",
          "mobile",
          "low"
        ]
      }
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tris": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "gpuTexMB": {
            "type": "number",
            "minimum": 0
          },
          "decoders": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "meshopt",
                "draco",
                "ktx2"
              ]
            }
          }
        },
        "required": [
          "bytes",
          "decoders"
        ],
        "additionalProperties": {}
      }
    },
    "assets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "file": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "desktop",
                "mobile",
                "low",
                "*"
              ]
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "mesh": {
            "type": "string"
          },
          "bounds": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          },
          "source": {
            "type": "object",
            "properties": {
              "pack": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "pack",
              "version",
              "path"
            ],
            "additionalProperties": {}
          },
          "license": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "attribution": {
                "type": "string"
              },
              "use": {
                "type": "string",
                "enum": [
                  "any",
                  "personal",
                  "inspiration"
                ]
              }
            },
            "required": [
              "id",
              "use"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "file",
          "license"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "version",
    "tiers",
    "files",
    "assets"
  ],
  "additionalProperties": {},
  "$id": "https://open-game-maker-2000.local/schemas/assets.v1.json"
}
