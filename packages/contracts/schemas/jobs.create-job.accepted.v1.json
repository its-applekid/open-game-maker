{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "jobId": {
      "type": "string",
      "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "admitted"
      ]
    },
    "reservation": {
      "type": "object",
      "properties": {
        "amountMicroUsd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sizeClass": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large",
            "huge"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "required": [
        "amountMicroUsd",
        "sizeClass",
        "confidence"
      ],
      "additionalProperties": false
    },
    "slot": {
      "type": "string",
      "enum": [
        "new_game",
        "edit"
      ]
    },
    "position": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "jobId",
    "state",
    "reservation",
    "slot"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/jobs.create-job.accepted.v1.json"
}
