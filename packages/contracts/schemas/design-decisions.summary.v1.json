{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D-[0-9]{2,}$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "chosen": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,32}$"
          },
          "chosen_label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "origin": {
            "type": "string",
            "enum": [
              "player",
              "default"
            ]
          },
          "skipped": {
            "type": "boolean"
          },
          "supersedes": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^D-[0-9]{2,}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "id",
          "question",
          "chosen",
          "chosen_label",
          "origin",
          "skipped",
          "supersedes",
          "at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "decisions"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/design-decisions.summary.v1.json"
}
