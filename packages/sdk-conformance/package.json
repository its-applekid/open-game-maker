{
  "name": "@gm/sdk-conformance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "gm-sdk": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b && esbuild src/host-page/main.ts --bundle --format=esm --platform=browser --outfile=dist/host-page/main.js",
    "pretypecheck": "pnpm --filter @ogm/contracts --filter @ogm/iframe-bridge --filter @gm/host --filter @ogm/gm-verify --filter @ogm/config build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @ogm/contracts build",
    "test": "vitest run",
    "test:e2e": "pnpm build && vitest run --config vitest.e2e.config.ts",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@gm/host": "workspace:*",
    "@ogm/config": "workspace:*",
    "@ogm/contracts": "workspace:*",
    "@ogm/gm-verify": "workspace:*",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vitest": "5.0.5"
  }
}
