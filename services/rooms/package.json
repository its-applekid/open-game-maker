{
  "name": "@ogm/rooms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx src/main.ts",
    "lint": "eslint src test vitest.config.ts",
    "pretest": "pnpm --filter @ogm/config --filter @ogm/contracts --filter @ogm/health --filter @ogm/room-protocol build",
    "pretypecheck": "pnpm --filter @ogm/config --filter @ogm/contracts --filter @ogm/health --filter @ogm/room-protocol build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@colyseus/core": "0.18.24",
    "@colyseus/schema": "5.0.43",
    "@colyseus/ws-transport": "0.18.4",
    "@hono/node-server": "2.1.5",
    "@ogm/config": "workspace:*",
    "@ogm/contracts": "workspace:*",
    "@ogm/health": "workspace:*",
    "@ogm/room-protocol": "workspace:*",
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.9",
    "@colyseus/testing": "0.18.6",
    "tsx": "4.23.15"
  }
}
