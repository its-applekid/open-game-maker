{
  "name": "@ogm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app/app.d.ts",
      "default": "./dist/app/app.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "pretypecheck": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src test vitest.config.ts",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.15",
    "@hono/node-server": "2.1.5",
    "@ogm/blob-store": "workspace:*",
    "@ogm/config": "workspace:*",
    "@ogm/contracts": "workspace:*",
    "@ogm/db": "workspace:*",
    "@ogm/game-repo-template": "workspace:*",
    "@ogm/health": "workspace:*",
    "@ogm/policy": "workspace:*",
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "nodemailer": "10.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "tsx": "4.23.15"
  }
}
