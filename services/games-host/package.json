{
  "name": "@ogm/games-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "pretypecheck": "pnpm --filter @ogm/contracts build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @ogm/contracts build",
    "test": "vitest run",
    "pretest:browser": "pnpm --filter @ogm/contracts build",
    "test:browser": "playwright test",
    "lint": "eslint src test playwright.config.ts vitest.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@ogm/contracts": "workspace:*",
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
