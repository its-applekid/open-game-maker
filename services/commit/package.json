{
  "name": "@ogm/commit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx src/index.ts",
    "lint": "eslint src",
    "pretest": "pnpm --filter @ogm/config --filter @ogm/contracts --filter @ogm/game-repo-template build",
    "pretypecheck": "pnpm --filter @ogm/config --filter @ogm/contracts --filter @ogm/game-repo-template build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@octokit/auth-app": "8.3.1",
    "@octokit/request": "10.0.16",
    "@ogm/config": "workspace:*",
    "@ogm/contracts": "workspace:*",
    "@ogm/game-repo-template": "workspace:*",
    "hono": "4.13.16",
    "octokit": "5.0.5"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
