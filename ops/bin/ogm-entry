#!/usr/bin/env bash
# Print the entry file a service's package.json start script runs.
# usage: ogm-entry <service-dir>
# exit 1 when the package has no start script of the form `node <file>`.

set -euo pipefail

[[ $# -eq 1 ]] || { printf 'usage: ogm-entry <service-dir>\n' >&2; exit 64; }
dir=$1

start=$(node --no-warnings -e 'const p = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"));
  process.stdout.write(p.scripts?.start ?? "");' "$dir/package.json")
if [[ ! $start =~ ^node\ ([^[:space:]]+)$ ]]; then
  printf 'ogm-entry: %s/package.json start script is not "node <file>": %s\n' "$dir" "${start:-(none)}" >&2
  exit 1
fi
printf '%s/%s\n' "$dir" "${BASH_REMATCH[1]}"
