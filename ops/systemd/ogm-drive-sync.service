# OGM Drive sync. Installed by ops/bin/ogm-host-setup.sh (replaces @REPO@). Logs: journalctl --user -u ogm-drive-sync -f
[Unit]
Description=OGM Drive asset watch folder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Slice=ogm.slice
Environment=OGM_REPO=@REPO@
EnvironmentFile=-%h/.config/ogm/env/drive-sync.env
ExecStart=@REPO@/ops/bin/ogm-run drive-sync
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
KillMode=mixed
TimeoutStopSec=30
LogRateLimitIntervalSec=30
LogRateLimitBurst=1000

[Install]
WantedBy=default.target
