# OGM game-builder daemon, one per active game repo. @ogm/builder's fleet renders %i's directory and env file.
[Unit]
Description=OGM game-builder aiur daemon (%i)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
Slice=ogm-agents.slice
WorkingDirectory=%h/.local/share/ogm/daemons/%i
EnvironmentFile=%h/.config/ogm/env/ogm-aiur@%i.env
Environment=AIUR_REPO_ROOT=%h/github/aiur
ExecStart=%h/github/aiur/scripts/aiurdev run --container
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=65
UMask=0077
NoNewPrivileges=yes
LogRateLimitIntervalSec=30
LogRateLimitBurst=1000
