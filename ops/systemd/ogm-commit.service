# OGM commit service. Installed by ops/bin/ogm-host-setup.sh (replaces @REPO@). Logs: journalctl --user -u ogm-commit -f
[Unit]
Description=OGM commit service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Slice=ogm.slice
Environment=OGM_REPO=@REPO@
EnvironmentFile=-%h/.config/ogm/env/ogm-commit.env
ExecStart=@REPO@/ops/bin/ogm-run commit
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
KillMode=mixed
TimeoutStopSec=30
LogRateLimitIntervalSec=30
LogRateLimitBurst=1000
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-%h/.local/share/ogm

[Install]
WantedBy=default.target
