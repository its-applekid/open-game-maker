# OGM asset intake. Installed by ops/bin/ogm-host-setup.sh (replaces @REPO@). Logs: journalctl --user -u ogm-intake -f
[Unit]
Description=OGM asset intake
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Slice=ogm.slice
Environment=OGM_REPO=@REPO@
EnvironmentFile=-%h/.config/ogm/env/intake.env
ExecStart=@REPO@/ops/bin/ogm-run intake
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
KillMode=mixed
TimeoutStopSec=30
LogRateLimitIntervalSec=30
LogRateLimitBurst=1000

[Install]
WantedBy=default.target
